# Drivers used by all Android virtual devices
CONFIG_BATTERY_GOLDFISH=m
CONFIG_BT_HCIVHCI=m
CONFIG_BT_HCIUART=m
CONFIG_CPUFREQ_DUMMY=m # nocheck: aarch64.fragment disables this for xen
CONFIG_DMABUF_HEAPS_SYSTEM=m
CONFIG_DRM_VKMS=m
CONFIG_MAC80211_HWSIM=m
CONFIG_RTC_DRV_TEST=m
CONFIG_USB_DUMMY_HCD=m # nocheck: aarch64.fragment disables this for xen
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_PMEM=m
CONFIG_USBIP_CORE=m
CONFIG_USBIP_VHCI_HCD=m

# Drivers to run specific sanity tests
CONFIG_TEST_STACKINIT=m # nocheck: symbol no longer exists in this kernel
CONFIG_TEST_MEMINIT=m # nocheck: RUNTIME_TESTING_MENU not enabled in aarch64

# Cuttlefish-specific drivers
CONFIG_VIRT_WIFI=m

CONFIG_CFG80211=m
CONFIG_NL80211_TESTMODE=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REG_CELLULAR_HINTS=y
CONFIG_MAC80211=m
